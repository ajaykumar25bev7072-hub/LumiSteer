# LumiSteer environment — copy backend values into backend/.env (or export them)
# and frontend values into frontend/.env.local. Never commit real keys.

# --- Nebius Token Factory (LLM agent) -----------------------------------------
# Get a key: https://api.tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Any current NVIDIA Nemotron model id from the Token Factory model list, e.g.
#   nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
#   nvidia/nemotron-3-super-...   (check the live model list endpoint)
NEBIUS_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5

# --- FastAPI ------------------------------------------------------------------
# Comma-separated allowed origins for CORS (default * for local dev)
CORS_ORIGINS=*

# --- Frontend (frontend/.env.local, only needed outside local dev) -------------
# VITE_API_BASE=https://your-backend.example.com
